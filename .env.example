# =====================================================================
# Gaming Tournament Management System - Environment Variables Template
# Copy this file to backend/.env and customize with your credentials
# =====================================================================

# MySQL 8.0 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=gaming_tournament_db

# Backend Express Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Frontend CORS Origin URL
CLIENT_URL=http://localhost:5173
